{
    "app-id": "org.kde.kid3",
    "branch": "master",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.11",
    "sdk": "org.kde.Sdk",
    "command": "kid3",
    "rename-icon": "kid3",
    "tags": ["nightly"],
    "desktop-file-name-suffix": " (Nightly)",
    "finish-args": [
        "--socket=wayland",
        "--socket=fallback-x11",
        "--socket=pulseaudio",
        "--share=ipc",
        "--device=dri",
        "--share=network",
        "--filesystem=xdg-download",
        "--filesystem=xdg-music",
        "--env=TMPDIR=/var/tmp",
        "--own-name=org.mpris.MediaPlayer2.kid3"
    ],
    "cleanup": [
        "/man",
        "/share/doc",
        "/share/man",
        "/include",
        "/lib/*.a",
        "/lib/*.la",
        "/lib/cmake",
        "/lib/pkgconfig",
        "/share/**/*-qt.*",
        "/share/icons/**/**/**/*-qt.*"
    ],
    "modules": [
        {
            "name": "chromaprint",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=RelWithDebInfo"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/acoustid/chromaprint/archive/v1.6.1.tar.gz",
                    "sha256": "7065ec9db48ac1fa929ec6c42afcd966605b1bfe48b6d5e64c25378a05f4fb02",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 286,
                        "stable-only": true,
                        "url-template": "https://github.com/acoustid/chromaprint/archive/v$version.tar.gz"
                    }
                }
            ]
        },
        {
            "name": "mp4v2",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DCMAKE_POLICY_VERSION_MINIMUM=3.5",
                "-DCMAKE_BUILD_TYPE=RelWithDebInfo",
                "-DBUILD_UTILS=OFF"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/enzo1982/mp4v2/releases/download/v2.1.3/mp4v2-2.1.3.tar.bz2",
                    "sha256": "033185c17bf3c5fdd94020c95f8325be2e5356558e3913c3d6547a85dd61f7f1"
                }
            ]
        },
        {
            "name": "kid3",
            "buildsystem": "cmake-ninja",
            "make-install-args": [
                "check"
            ],
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=RelWithDebInfo",
                "-DWITH_APPS=KDE;Qt;CLI",
                "-DWITH_MP4V2=ON",
                "-DDOCBOOK_XSL_DIR=/usr/share/xml/docbook/xml/xsl-stylesheets",
                "-DKDE_SKIP_TEST_SETTINGS=ON",
                "-DBUILD_WITH_QT6=ON"
            ],
            "post-install": [
                "gunzip -S z /app/share/icons/hicolor/scalable/apps/kid3.svgz"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "../.."
                }
            ]
        }
    ]
}
